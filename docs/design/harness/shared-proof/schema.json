{
  "schema": "shared-proof-contract/1",
  "measurementOnly": true,
  "runtimeValidation": "preflight.js and cli.js enforce the full contract; this is the discoverable field inventory",
  "request": {"schema": "shared-proof-request/1", "required": ["adapter", "runs"], "roles": ["base1", "base2", "after"], "optional": ["sensitivity"]},
  "run": {"schema": "shared-proof-run/1", "required": ["runId", "sourceCommit", "manifestSha256", "harnessSha256", "adapterSha256", "completed", "error", "startedAt", "endedAt", "inputFilesBefore", "inputFilesAfter", "steps"]},
  "step": {"required": ["id", "fullDom", "fullDomSha256", "featureDom", "localStorage", "sessionStorage", "toasts", "consoleErrors", "pageerrors", "postconditions", "functionEntries"], "clickRequired": ["method", "target", "success", "isTargetOrDescendant", "inViewport", "nonZero"]},
  "adapter": {"schema": "shared-proof-adapter/1", "required": ["taskId", "collectionReady", "steps", "dynamicContracts", "negativeCases"]},
  "sensitivity": {"schema": "shared-proof-sensitivity/1", "required": ["independent", "coreSha256", "adapterSha256", "inputShas", "cases"]},
  "requiredGates": ["schema", "input", "dynamic", "baseline", "work", "sensitivity"],
  "dynamicDisposition": "unmeasured; unsupported provenance is rejected, no normalization",
  "output": {"schema": "shared-proof-result/1", "productVerdict": null, "effect": null}
}
