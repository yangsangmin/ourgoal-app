{
  "id": "home-theme-entrances-gone",
  "title": "게스트 홈 체크인 카드에 CSS 로 숨겨져 있던 테마 선택 입구(#captureLiveTheme 배지, #captureThemeQuickBar 의 +테마 #btnOpenThemeModal·즐겨찾기 칩)가 DOM 에 없고, 글자수 힌트 #captureCharCount 는 남아 있다",
  "steps": [
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": "#homeAddGoal", "timeoutMs": 15000 },
    { "do": "type", "selector": "#captureInput", "text": "오늘 아침 5km 조깅 완주" },
    { "expect": "notExists", "selector": "#captureLiveTheme" },
    { "expect": "notExists", "selector": "#captureThemeQuickBar" },
    { "expect": "notExists", "selector": "#btnOpenThemeModal" },
    { "expect": "notExists", "selector": ".theme-fav-chip" },
    { "expect": "exists", "selector": "#captureLiveMeta #captureCharCount" },
    { "capture": "home-capture-no-theme-entrance" }
  ]
}
