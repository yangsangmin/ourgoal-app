{
  "id": "checkin-save-daily-theme",
  "title": "테마 선택 창을 지운 뒤에도 게스트가 홈에서 한 줄 체크인을 적고 저장하면 저장되어 경험치 토스트가 뜬다(테마 칸은 buildCheckinThemePayload 가 채움)",
  "steps": [
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": "#homeAddGoal", "timeoutMs": 15000 },
    { "do": "type", "selector": "#captureInput", "text": "오늘 아침 5km 조깅 완주" },
    { "do": "click", "selector": "#captureSave" },
    { "expect": "textContains", "selector": "#toast", "text": "(+10 EXP)", "timeoutMs": 8000 },
    { "capture": "checkin-saved" }
  ]
}
