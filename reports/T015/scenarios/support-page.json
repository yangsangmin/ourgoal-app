{
  "id": "t015-support-page",
  "title": "지원 페이지에 자주 묻는 질문 5개가 있고, AI 질문을 누르면 답(동의 안내)이 펼쳐진다",
  "steps": [
    { "do": "goto", "path": "/support.html" },
    { "do": "waitFor", "selector": "details" },
    { "expect": "count", "selector": "details", "equals": 5 },
    { "expect": "textContains", "selector": "#openchat", "text": "준비 중" },
    { "expect": "noHorizontalOverflow" },
    { "do": "click", "selector": "details:nth-of-type(2) > summary" },
    { "expect": "textContains", "selector": "details[open]", "text": "동의를 받아요" }
  ]
}
