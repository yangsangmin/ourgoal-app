{
  "id": "settings-guide-comm-tour",
  "title": "게스트로 설정 탭 「앱 기본 가이드 다시보기」 → 미니 가이드 「건너뛰기」를 누르면 가이드가 끝나며 옮긴 소통 기능 투어 창(showCommTourModal — js/tabs/settings/comm-tour.js)이 뜨고, 「소통 탭 보러가기」를 누르면 소통 탭으로 간다",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"settings\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"settings\"]"
    },
    {
      "do": "waitFor",
      "selector": "#setGroupDataSummary",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": "#setGroupDataSummary"
    },
    {
      "do": "waitFor",
      "selector": "#btnRestartGuide",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": "#btnRestartGuide"
    },
    {
      "do": "waitFor",
      "selector": "#btnMiniGuideSkip",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnMiniGuideSkip"
    },
    {
      "do": "waitFor",
      "selector": "#tourGo",
      "timeoutMs": 10000
    },
    {
      "expect": "textContains",
      "selector": "#modalOverlay",
      "text": "첫 목표를 만들었어요!"
    },
    {
      "do": "click",
      "selector": "#tourGo"
    },
    {
      "expect": "hasClass",
      "selector": "#screen-comm",
      "className": "active"
    },
    {
      "expect": "noExceptions"
    }
  ]
}
