{
  "id": "records-focus-timer-ok",
  "title": "게스트 기록 탭의 성소 「⏱️ 몰입 타이머」 단추를 누르면 그 단추가 켜진다 — 빠른 스톱워치를 지운 뒤 남은 진입로",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"records\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"records\"]"
    },
    {
      "do": "waitFor",
      "selector": "#sRecModesWrap",
      "timeoutMs": 10000
    },
    {
      "expect": "notHasClass",
      "selector": "#sRecModesWrap > button:nth-child(2)",
      "className": "active"
    },
    {
      "do": "click",
      "selector": "#sRecModesWrap > button:nth-child(2)"
    },
    {
      "expect": "hasClass",
      "selector": "#sRecModesWrap > button:nth-child(2)",
      "className": "active",
      "timeoutMs": 6000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
