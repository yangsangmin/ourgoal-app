{
  "id": "records-timeline-calendar-ok",
  "title": "게스트 기록 탭의 성소 「📝 실천 타임라인」 단추를 누르면 내 기록 보기(#recViewFeed)가 보이고, 달력 탭으로 옮겨도 달력 화면이 열린다 — 융합 칩을 지운 뒤 남은 진입로",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"records\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"records\"]"
    },
    {
      "do": "waitFor",
      "selector": "#sRecModesWrap",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#sRecModesWrap > button:nth-child(1)"
    },
    {
      "do": "click",
      "selector": "#sRecModesWrap > button:nth-child(3)"
    },
    {
      "expect": "visible",
      "selector": "#recViewFeed",
      "timeoutMs": 6000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"calendar\"]"
    },
    {
      "expect": "visible",
      "selector": "#screen-calendar",
      "timeoutMs": 6000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
