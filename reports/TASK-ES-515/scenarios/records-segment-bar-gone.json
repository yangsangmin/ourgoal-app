{
  "id": "records-segment-bar-gone",
  "title": "게스트로 기록 탭에 들어가면 숨은 옛 세그먼트 막대(#recSegmentBar)가 없고, 성소 「📈 히트맵·통계」 단추는 눌러 통계 보기(#recViewStats)가 보인다",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"records\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"records\"]"
    },
    {
      "do": "waitFor",
      "selector": "#sRecModesWrap",
      "timeoutMs": 10000
    },
    {
      "expect": "notExists",
      "selector": "#recSegmentBar"
    },
    {
      "expect": "notExists",
      "selector": "#recSegFeedBtn"
    },
    {
      "do": "click",
      "selector": "#sRecModesWrap > button:nth-child(3)"
    },
    {
      "do": "click",
      "selector": "#sRecModesWrap > button:nth-child(1)"
    },
    {
      "expect": "visible",
      "selector": "#recViewStats",
      "timeoutMs": 6000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
