{
  "id": "goals-overflow-verified",
  "title": "목표 탭 진입 시 375px 화면에서 가로로 넘치지 않고 구형 서브탭이 은폐되며 단일 스티키 서브바가 노출된다",
  "steps": [
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": ".navbtn[data-tab=\"goals\"]" },
    { "do": "setViewport", "width": 375, "height": 812 },
    { "do": "click", "selector": ".navbtn[data-tab=\"goals\"]" },
    { "do": "waitFor", "selector": "#screen-goals" },
    { "do": "wait", "ms": 500 },
    { "expect": "noHorizontalOverflow" },
    { "expect": "visible", "selector": "#goalsStickySubnav" },
    { "expect": "notVisible", "selector": "#goalsSubtabs" },
    { "capture": "goals-overflow-verified" }
  ]
}
