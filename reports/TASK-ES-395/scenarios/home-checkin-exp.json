{
  "id": "home-checkin-exp",
  "title": "게스트로 홈에서 체크인 입력칸(#captureInput)에 한 줄을 적고 「오늘 실천 완료 ✨ (+10 EXP)」(#captureSave)를 누르면 축하 팝업(#avatarCelebrationToast)에 「EXP 획득」이 뜨고, 홈 레벨 배지(#levelBadgeRow)의 경험치 글자가 「0 / 100 XP」에서 「40 / 100 XP」(체크인 +10 · 데일리 퀘스트 오늘 한 줄 체크인 +30)로 오른다 — EXP 코드를 옮기기만 했으므로 기준 커밋에서도 같은 결과여야 한다",
  "steps": [
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": "#homeAddGoal", "timeoutMs": 15000 },
    { "expect": "textContains", "selector": "#levelBadgeRow", "text": "0 / 100 XP", "timeoutMs": 10000 },
    { "capture": "home-before-checkin" },
    { "do": "click", "selector": "#captureInput" },
    { "do": "type", "selector": "#captureInput", "text": "오늘 아침 5km 러닝 완료" },
    { "do": "click", "selector": "#captureSave" },
    { "expect": "textContains", "selector": "#avatarCelebrationToast", "text": "EXP 획득", "timeoutMs": 6000 },
    { "expect": "textContains", "selector": "#levelBadgeRow", "text": "40 / 100 XP", "timeoutMs": 10000 },
    { "capture": "home-after-checkin" },
    { "expect": "noExceptions" }
  ]
}
