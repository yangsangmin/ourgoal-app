{
  "id": "calendar-dock",
  "title": "게스트 진입 후 일정 탭을 누르면 캘린더 메가블록 화면이 정상 표시된다",
  "steps": [
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": ".navbtn[data-tab=\"calendar\"]" },
    { "do": "click", "selector": ".navbtn[data-tab=\"calendar\"]" },
    { "do": "waitFor", "selector": "#screen-calendar" },
    { "expect": "visible", "selector": "#screen-calendar" },
    { "expect": "hasClass", "selector": ".navbtn[data-tab=\"calendar\"]", "className": "active" },
    { "capture": "calendar-dock-mounted" }
  ]
}
