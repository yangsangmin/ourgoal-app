{
  "id": "team-subtask-toggle",
  "title": "게스트가 체험 팀(2026 하반기 전략 워크숍 TF) 목표 카드에서 「마일스톤 펼치기 ▼」로 목록을 연 뒤 1단계 마일스톤의 「세부 할 일 2/2 ▼」를 한 번 누르면 세부 할 일 상자가 보이고 화살표가 ▲ 로 바뀌며, 한 번 더 누르면 상자가 접히고 ▼ 로 돌아온다 — 기준 커밋에서는 첫 클릭 뒤에도 상자가 안 보인다(두 손잡이가 한 번씩 뒤집음)",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": "#homeAddGoal",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"goals\"]"
    },
    {
      "do": "click",
      "selector": "#btnGoalsSubTeam"
    },
    {
      "do": "click",
      "selector": "[data-tgexampletab=\"workshop\"]"
    },
    {
      "do": "click",
      "selector": "[data-tgquickjoin=\"g-workshop\"]"
    },
    {
      "expect": "textContains",
      "selector": "#teamGoalsView [data-tgfoldlist]",
      "text": "마일스톤 펼치기",
      "timeoutMs": 5000
    },
    {
      "do": "click",
      "selector": "#teamGoalsView [data-tgfoldlist]"
    },
    {
      "expect": "visible",
      "selector": "#teamGoalsView [data-tgmslist]",
      "timeoutMs": 3000
    },
    {
      "expect": "textContains",
      "selector": "#teamGoalsView [data-tgtoggletasks=\"tg-ws-1:tgm-ws-1a\"] .t-arrow",
      "text": "▼"
    },
    {
      "expect": "notVisible",
      "selector": "#teamGoalsView [data-tgtaskbox=\"tg-ws-1:tgm-ws-1a\"]"
    },
    {
      "do": "click",
      "selector": "#teamGoalsView [data-tgtoggletasks=\"tg-ws-1:tgm-ws-1a\"]"
    },
    {
      "expect": "visible",
      "selector": "#teamGoalsView [data-tgtaskbox=\"tg-ws-1:tgm-ws-1a\"]",
      "timeoutMs": 3000
    },
    {
      "expect": "textContains",
      "selector": "#teamGoalsView [data-tgtoggletasks=\"tg-ws-1:tgm-ws-1a\"] .t-arrow",
      "text": "▲"
    },
    {
      "do": "click",
      "selector": "#teamGoalsView [data-tgtoggletasks=\"tg-ws-1:tgm-ws-1a\"]"
    },
    {
      "expect": "notVisible",
      "selector": "#teamGoalsView [data-tgtaskbox=\"tg-ws-1:tgm-ws-1a\"]",
      "timeoutMs": 3000
    },
    {
      "expect": "textContains",
      "selector": "#teamGoalsView [data-tgtoggletasks=\"tg-ws-1:tgm-ws-1a\"] .t-arrow",
      "text": "▼"
    },
    {
      "expect": "noExceptions"
    }
  ]
}
