{
  "id": "s3-comm-feed-opens",
  "title": "게스트로 소통 탭의 피드 하위 탭을 누르면 피드 머리 문구가 보이고 예외가 없다 (잠긴 두 곳을 구역으로 옮긴 모의본의 확인 — 기준 작업 폴더와 모의 작업 폴더에서 같은 조작)",
  "steps": [
    {
      "do": "setViewport",
      "width": 430,
      "height": 932
    },
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": "#btnAvatarGreetClose",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnAvatarGreetClose"
    },
    {
      "expect": "notVisible",
      "selector": "#btnAvatarGreetClose"
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"comm\"]"
    },
    {
      "do": "waitFor",
      "selector": ".comm-subtab[data-sub=\"feed\"]",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": ".comm-subtab[data-sub=\"feed\"]"
    },
    {
      "expect": "hasClass",
      "selector": ".navbtn[data-tab=\"comm\"]",
      "className": "active"
    },
    {
      "expect": "textContains",
      "selector": "#commSubBody",
      "text": "같은 목표를 향해 가는 사람들",
      "timeoutMs": 8000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
