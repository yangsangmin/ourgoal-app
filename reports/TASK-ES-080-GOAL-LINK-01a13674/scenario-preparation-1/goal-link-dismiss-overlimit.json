{
  "id": "goal-link-repeated-dismiss-device-guest",
  "title": "닫기를 선택하면 홈에 남고 다음 관련 기록의 제안을 줄인다",
  "viewport": {
    "width": 1280,
    "height": 900
  },
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": "#avatarGreetingModal",
      "timeoutMs": 15000
    },
    {
      "expect": "notVisible",
      "selector": "#avatarGreetingModal",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"goals\"]"
    },
    {
      "do": "waitFor",
      "selector": "#sAddGoalBtn",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": "#sAddGoalBtn"
    },
    {
      "do": "click",
      "selector": "#ngManualBtn"
    },
    {
      "do": "type",
      "selector": "#mGoalTitle",
      "text": "피아노 연습",
      "clear": true
    },
    {
      "do": "select",
      "selector": "#mGoalVis",
      "value": "private"
    },
    {
      "do": "click",
      "selector": "#mSave"
    },
    {
      "expect": "notHasClass",
      "selector": "#modalOverlay",
      "className": "active"
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"home\"]"
    },
    {
      "do": "waitFor",
      "selector": "#screen-home.active",
      "timeoutMs": 15000
    },
    {
      "do": "type",
      "selector": "#captureInput",
      "text": "피아노 첫째 연습",
      "clear": true
    },
    {
      "do": "click",
      "selector": "#captureSave"
    },
    {
      "expect": "count",
      "selector": "#captureInput:placeholder-shown",
      "equals": 1,
      "timeoutMs": 20000
    },
    {
      "expect": "attr",
      "selector": "#captureSyncStatus",
      "name": "data-sync-state",
      "equals": "local",
      "timeoutMs": 20000
    },
    {
      "do": "waitFor",
      "selector": "#firstCheckinDoneBtn",
      "timeoutMs": 15000
    },
    {
      "expect": "notVisible",
      "selector": "#recordGoalLinkSuggestion"
    },
    {
      "do": "click",
      "selector": "#firstCheckinDoneBtn"
    },
    {
      "do": "waitFor",
      "selector": "#btnCheckinAiClose",
      "timeoutMs": 20000
    },
    {
      "expect": "notVisible",
      "selector": ".checkin-ai-loading-box",
      "timeoutMs": 20000
    },
    {
      "expect": "notVisible",
      "selector": "#recordGoalLinkSuggestion"
    },
    {
      "do": "click",
      "selector": "#btnCheckinAiClose"
    },
    {
      "do": "waitFor",
      "selector": "#recordGoalLinkSuggestion",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": "#recordGoalLinkClose"
    },
    {
      "expect": "notHasClass",
      "selector": "#modalOverlay",
      "className": "active"
    },
    {
      "expect": "visible",
      "selector": "#screen-home.active"
    },
    {
      "do": "type",
      "selector": "#captureInput",
      "text": "피아노 둘째 연습",
      "clear": true
    },
    {
      "do": "click",
      "selector": "#captureSave"
    },
    {
      "expect": "count",
      "selector": "#captureInput:placeholder-shown",
      "equals": 1,
      "timeoutMs": 20000
    },
    {
      "expect": "attr",
      "selector": "#captureSyncStatus",
      "name": "data-sync-state",
      "equals": "local",
      "timeoutMs": 20000
    },
    {
      "do": "waitFor",
      "selector": "#btnCheckinAiClose",
      "timeoutMs": 20000
    },
    {
      "expect": "notVisible",
      "selector": ".checkin-ai-loading-box",
      "timeoutMs": 20000
    },
    {
      "expect": "notVisible",
      "selector": "#recordGoalLinkSuggestion"
    },
    {
      "do": "click",
      "selector": "#btnCheckinAiClose"
    },
    {
      "do": "wait",
      "ms": 1000
    },
    {
      "expect": "notVisible",
      "selector": "#recordGoalLinkSuggestion"
    },
    {
      "do": "type",
      "selector": "#captureInput",
      "text": "피아노 셋째 연습",
      "clear": true
    },
    {
      "do": "click",
      "selector": "#captureSave"
    },
    {
      "expect": "count",
      "selector": "#captureInput:placeholder-shown",
      "equals": 1,
      "timeoutMs": 20000
    },
    {
      "expect": "attr",
      "selector": "#captureSyncStatus",
      "name": "data-sync-state",
      "equals": "local",
      "timeoutMs": 20000
    },
    {
      "do": "waitFor",
      "selector": "#btnCheckinAiClose",
      "timeoutMs": 20000
    },
    {
      "expect": "notVisible",
      "selector": ".checkin-ai-loading-box",
      "timeoutMs": 20000
    },
    {
      "expect": "notVisible",
      "selector": "#recordGoalLinkSuggestion"
    },
    {
      "do": "click",
      "selector": "#btnCheckinAiClose"
    },
    {
      "do": "wait",
      "ms": 1000
    },
    {
      "expect": "notVisible",
      "selector": "#recordGoalLinkSuggestion"
    },
    {
      "do": "type",
      "selector": "#captureInput",
      "text": "피아노 넷째 연습",
      "clear": true
    },
    {
      "do": "click",
      "selector": "#captureSave"
    },
    {
      "expect": "count",
      "selector": "#captureInput:placeholder-shown",
      "equals": 1,
      "timeoutMs": 20000
    },
    {
      "expect": "attr",
      "selector": "#captureSyncStatus",
      "name": "data-sync-state",
      "equals": "local",
      "timeoutMs": 20000
    },
    {
      "do": "waitFor",
      "selector": "#btnCheckinAiClose",
      "timeoutMs": 20000
    },
    {
      "expect": "notVisible",
      "selector": ".checkin-ai-loading-box",
      "timeoutMs": 20000
    },
    {
      "expect": "notVisible",
      "selector": "#recordGoalLinkSuggestion"
    },
    {
      "do": "click",
      "selector": "#btnCheckinAiClose"
    },
    {
      "do": "waitFor",
      "selector": "#recordGoalLinkSuggestion",
      "timeoutMs": 15000
    },
    {
      "expect": "textContains",
      "selector": "#recordGoalLinkTarget",
      "text": "피아노 연습"
    },
    {
      "do": "click",
      "selector": "#recordGoalLinkClose"
    },
    {
      "capture": "goal-link-repeated-dismiss"
    }
  ]
}
