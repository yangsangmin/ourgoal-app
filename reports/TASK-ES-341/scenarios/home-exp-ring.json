{
  "id": "home-exp-ring",
  "title": "홈 아바타 진행 바는 숫자 없이 실제 경험치(settings.xp.total) 비율을 보여 주고, 체크인하면 비율이 오른다",
  "steps": [
    { "do": "setViewport", "width": 375, "height": 812 },
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "expect": "visible", "selector": "#homeHeroAvatarCard", "timeoutMs": 15000 },
    { "expect": "visible", "selector": "#homeHeroExpBar" },
    { "expect": "notVisible", "selector": "#homeHeroExpText" },
    { "expect": "attr", "selector": "#homeHeroExpBar", "name": "aria-valuenow", "equals": "0" },
    { "capture": "home-exp-ring-before-checkin" },
    { "do": "click", "selector": "#captureInput" },
    { "do": "type", "selector": "#captureInput", "text": "오늘 5km 러닝 완료" },
    { "do": "click", "selector": "#captureSave" },
    { "expect": "attr", "selector": "#homeHeroExpBar", "name": "aria-valuenow", "equals": "50", "timeoutMs": 8000 },
    { "expect": "notVisible", "selector": "#homeHeroExpText" },
    { "capture": "home-exp-ring-after-checkin" },
    { "expect": "noExceptions" }
  ]
}
