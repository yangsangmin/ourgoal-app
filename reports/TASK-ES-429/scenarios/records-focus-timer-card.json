{
  "id": "records-focus-timer-card",
  "title": "게스트로 기록 탭에 들어가 포커스 성소 기록 모드 바(#sRecModesWrap)의 「⏱️ 몰입 타이머」를 누르면 성소 기록 칸(#sanctuaryRecordsView)에 25분 뽀모도로 타이머 카드가 그려지고 시계(#sPomodoroDisplay)가 「25:00」으로 보인다 — 타이머 카드 그리기(renderSanctuaryRecords 의 timer 분기 본문)를 js/sanctuary-focus-timer.js 로 옮기기만 했으므로 기준 커밋에서도 같은 결과여야 한다",
  "steps": [
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": "#homeAddGoal", "timeoutMs": 15000 },
    { "do": "click", "selector": ".navbtn[data-tab=\"records\"]" },
    { "do": "waitFor", "selector": "#sRecModesWrap", "timeoutMs": 8000 },
    { "do": "click", "selector": "#sRecModesWrap .s-rec-mode-btn:nth-child(2)" },
    { "expect": "visible", "selector": "#sPomodoroDisplay", "timeoutMs": 5000 },
    { "expect": "textEquals", "selector": "#sPomodoroDisplay", "text": "25:00" },
    { "expect": "hasClass", "selector": "#sRecModesWrap .s-rec-mode-btn:nth-child(2)", "className": "active" },
    { "expect": "noExceptions" }
  ]
}
