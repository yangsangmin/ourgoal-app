  "requirements": [
    {
      "id": "R1",
      "text": "ui.css에 토스 설정 요약 원카드(.toss-settings-hero-card) 스타일이 정의되어야 한다"
    },
    {
      "id": "R2",
      "text": "index.html의 설정 탭(#screen-settings)에 문장형 헤드라인(#settingsHeadlineSentence)과 원카드 슬롯이 배선되어야 한다"
    },
    {
      "id": "R3",
      "text": "설정 아코디언 조작 및 옵션 변경 시 12ms 미세 햅틱 피드백(triggerHapticFeedback)이 배선되어야 한다"
    },
    {
      "id": "R4",
      "text": "기존 38대 헌법 무결성 게이트 및 5대 설정 아코디언 규격이 100% 보존되어야 한다"
    },
    {
      "id": "R5",
      "text": "781개 정적 버튼 Dead-Click 검사가 100% ALL PASS를 유지해야 한다"
    }
  ],
  "claims": [
