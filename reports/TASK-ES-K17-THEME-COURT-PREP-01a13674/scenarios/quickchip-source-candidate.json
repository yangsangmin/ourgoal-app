{
  "id": "k17-quickchip-source-candidate",
  "title": "기존 기본 러닝 칩의 실제 클릭 후 선택 상태와 확정 안내를 확인한다",
  "viewport": {
    "width": 1365,
    "height": 960
  },
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "expect": "visible",
      "selector": "#appShell.active",
      "timeoutMs": 15000
    },
    {
      "expect": "notVisible",
      "selector": "#avatarGreetingModal",
      "timeoutMs": 15000
    },
    {
      "expect": "textEquals",
      "selector": "#quickCheckinChips .btn-quick-chip[data-cunningtext=\"👟 30분 유산소 운동 완주! 땀 흘리며 스트레스 해소 완료 🔥\"]",
      "text": "👟 러닝/운동 실천"
    },
    {
      "expect": "notHasClass",
      "selector": "#quickCheckinChips .btn-quick-chip[data-cunningtext=\"👟 30분 유산소 운동 완주! 땀 흘리며 스트레스 해소 완료 🔥\"]",
      "className": "active-cunning"
    },
    {
      "do": "click",
      "selector": "#quickCheckinChips .btn-quick-chip[data-cunningtext=\"👟 30분 유산소 운동 완주! 땀 흘리며 스트레스 해소 완료 🔥\"]"
    },
    {
      "expect": "hasClass",
      "selector": "#quickCheckinChips .btn-quick-chip[data-cunningtext=\"👟 30분 유산소 운동 완주! 땀 흘리며 스트레스 해소 완료 🔥\"]",
      "className": "active-cunning"
    },
    {
      "expect": "attr",
      "selector": "#captureInput",
      "name": "placeholder",
      "equals": "기록하고 나의 역사데이터를 만들어요."
    },
    {
      "expect": "count",
      "selector": "#captureInput:placeholder-shown",
      "equals": 1
    },
    {
      "capture": "quickchip-fixed-guide"
    }
  ]
}
