{"do":"waitFor","selector":"#landLoginLink"},
{"expect":"style","selector":"#authScreen","prop":"display","equals":"none"},
{"do":"click","selector":"#landLoginLink"},
{"expect":"style","selector":"#landingScreen","prop":"display","equals":"none"},
{"expect":"style","selector":"#authScreen","prop":"display","equals":"flex"},
{"expect":"noExceptions"}]}
