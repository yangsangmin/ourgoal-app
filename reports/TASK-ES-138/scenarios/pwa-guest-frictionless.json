{
  "id": "pwa-guest-frictionless",
  "title": "설정 탭에서 44px PWA 홈화면 추가 3초 가이드 버튼을 누르면 OS 자동 감지 카드뉴스 모달이 노출된다",
  "steps": [
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#screen-home" },
    { "do": "wait", "ms": 500 },
    { "do": "click", "selector": ".navbtn[data-tab=\"settings\"]" },
    { "do": "waitFor", "selector": "#screen-settings" },
    { "do": "wait", "ms": 500 },
    { "do": "waitFor", "selector": "#btnPwaInstallGuide" },
    { "expect": "visible", "selector": "#btnPwaInstallGuide" },
    { "do": "click", "selector": "#btnPwaInstallGuide" },
    { "do": "waitFor", "selector": "#modalPwaInstallGuide" },
    { "expect": "visible", "selector": "#modalPwaInstallGuide" },
    { "expect": "visible", "selector": "#btnPwaOsIos" },
    { "expect": "visible", "selector": "#btnPwaOsAndroid" },
    { "expect": "visible", "selector": "#btnConfirmPwaInstall" },
    { "capture": "pwa-guest-frictionless" }
  ]
}
