{
 "id": "home-goal-list-after-starter",
 "title": "게스트로 홈 「오늘의 퀘스트」 나침반을 열면 목표가 없을 때 홈 목표 목록에 「아직 등록된 목표가 없어요」 스타터 안내가 보이고, 스타터 「매일 1시간 몰입」을 누르면 목록이 다시 그려져 「오늘 1순위 목표에 온전히 집중하는 날이에요」(목표 1개) 안내로 바뀐다 — 옮긴 renderHome(js/tabs/home/home-render.js)이 그린 목록",
 "steps": [
  {
   "do": "setViewport",
   "width": 430,
   "height": 3200
  },
  {
   "do": "goto",
   "path": "/index.html"
  },
  {
   "do": "waitFor",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "click",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "waitFor",
   "selector": ".navbtn[data-tab=\"settings\"]",
   "timeoutMs": 15000
  },
  {
   "do": "waitFor",
   "selector": "#homeCompassQuest",
   "timeoutMs": 10000
  },
  {
   "do": "click",
   "selector": "#homeCompassQuest"
  },
  {
   "do": "wait",
   "ms": 800
  },
  {
   "expect": "textContains",
   "selector": "#homeGoalList",
   "text": "아직 등록된 목표가 없어요"
  },
  {
   "do": "click",
   "selector": ".starter-goal-btn[data-starter=\"study\"]"
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "expect": "textContains",
   "selector": "#homeGoalList",
   "text": "오늘 1순위 목표에 온전히 집중하는 날이에요"
  },
  {
   "expect": "notVisible",
   "selector": ".starter-goal-btn[data-starter=\"study\"]"
  },
  {
   "expect": "noExceptions"
  }
 ]
}
