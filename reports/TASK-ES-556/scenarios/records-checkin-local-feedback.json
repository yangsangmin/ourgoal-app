{
 "id": "records-checkin-local-feedback",
 "title": "게스트로 홈 3초 체크인에 「오늘 기출문제 1회분 풀이 완료」를 넣어 저장하면 서버 AI 가 없을 때 「AI 응답량이 많아 고품질 추천 엔진으로 즉시 보답해 드렸습니다」 토스트가 뜬다 — 옮긴 GeminiQuotaDispatcher·PREMIUM_FEEDBACK_CATALOG(js/tabs/records/ai-feedback-catalog.js)의 대체 피드백",
 "steps": [
  {
   "do": "setViewport",
   "width": 430,
   "height": 3200
  },
  {
   "do": "goto",
   "path": "/index.html"
  },
  {
   "do": "waitFor",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "click",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "waitFor",
   "selector": ".navbtn[data-tab=\"settings\"]",
   "timeoutMs": 15000
  },
  {
   "do": "waitFor",
   "selector": "#captureInput",
   "timeoutMs": 10000
  },
  {
   "do": "type",
   "selector": "#captureInput",
   "text": "오늘 기출문제 1회분 풀이 완료"
  },
  {
   "do": "click",
   "selector": "#captureSave"
  },
  {
   "do": "wait",
   "ms": 1000
  },
  {
   "expect": "textContains",
   "selector": "#toast",
   "text": "고품질 추천 엔진으로 즉시 보답해 드렸습니다"
  },
  {
   "expect": "noExceptions"
  }
 ]
}
