{
  "id": "b3-settings-inline-handlers",
  "title": "게스트로 설정 탭에 들어가 설치 안내 창을 열고(onclick=openPwaInstallGuideModal) 기기 탭을 바꾸고(onclick=switchPwaOsTab) 닫은 뒤(onclick=closePwaInstallGuideModal), 화면 모드 칩을 누르면(onclick=switchUxMode) 누른 것이 활성이 되고 예외가 없다 (설정 키트 배선 철거 전후 보존)",
  "steps": [
    { "do": "setViewport", "width": 430, "height": 932 },
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect", "timeoutMs": 10000 },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": "#btnAvatarGreetClose", "timeoutMs": 10000 },
    { "do": "click", "selector": "#btnAvatarGreetClose" },
    { "expect": "notVisible", "selector": "#btnAvatarGreetClose" },
    { "do": "waitFor", "selector": ".navbtn[data-tab=\"settings\"]", "timeoutMs": 10000 },
    { "expect": "notHasClass", "selector": ".navbtn[data-tab=\"settings\"]", "className": "active" },
    { "do": "click", "selector": ".navbtn[data-tab=\"settings\"]" },
    { "expect": "hasClass", "selector": ".navbtn[data-tab=\"settings\"]", "className": "active" },
    { "do": "waitFor", "selector": "#btnPwaInstallGuide", "timeoutMs": 5000 },
    { "expect": "notVisible", "selector": "#btnPwaOsAndroid" },
    { "do": "click", "selector": "#btnPwaInstallGuide" },
    { "do": "waitFor", "selector": "#btnPwaOsAndroid", "timeoutMs": 5000 },
    { "expect": "hasClass", "selector": "#btnPwaOsIos", "className": "active" },
    { "expect": "notHasClass", "selector": "#btnPwaOsAndroid", "className": "active" },
    { "do": "click", "selector": "#btnPwaOsAndroid" },
    { "expect": "hasClass", "selector": "#btnPwaOsAndroid", "className": "active" },
    { "expect": "notHasClass", "selector": "#btnPwaOsIos", "className": "active" },
    { "do": "click", "selector": "#btnClosePwaGuide" },
    { "expect": "notVisible", "selector": "#btnPwaOsAndroid" },
    { "do": "click", "selector": "details:has(#btnModeGamified) > summary" },
    { "do": "waitFor", "selector": "#btnModeGamified", "timeoutMs": 5000 },
    { "expect": "hasClass", "selector": "#btnModeMinimal", "className": "active" },
    { "expect": "notHasClass", "selector": "#btnModeGamified", "className": "active" },
    { "do": "click", "selector": "#btnModeGamified" },
    { "expect": "hasClass", "selector": "#btnModeGamified", "className": "active" },
    { "expect": "notHasClass", "selector": "#btnModeMinimal", "className": "active" },
    { "do": "click", "selector": "#btnModeMinimal" },
    { "expect": "hasClass", "selector": "#btnModeMinimal", "className": "active" },
    { "expect": "notHasClass", "selector": "#btnModeGamified", "className": "active" },
    { "expect": "noExceptions" }
  ]
}
