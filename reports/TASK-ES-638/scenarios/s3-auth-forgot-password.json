{
  "id": "s3-auth-forgot-password",
  "title": "시작 화면에서 로그인 화면으로 가 「비밀번호를 잊으셨나요?」를 누르면 계정 보안 부품(OurgoalAuthSafety)이 「비밀번호 찾기」 창을 연다 (바깥 부품 연결 connectAuthSafety 이전 전후 보존)",
  "steps": [
    { "do": "setViewport", "width": 430, "height": 932 },
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#landLoginLink", "timeoutMs": 10000 },
    { "do": "click", "selector": "#landLoginLink" },
    { "do": "waitFor", "selector": "#forgotPassBtn", "timeoutMs": 10000 },
    { "expect": "notVisible", "selector": "#modalSheet" },
    { "do": "click", "selector": "#forgotPassBtn" },
    { "expect": "textContains", "selector": "#modalSheet", "text": "비밀번호 찾기" },
    { "expect": "noExceptions" }
  ]
}
