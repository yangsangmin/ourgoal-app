{
  "id": "s1-settings-legal-links",
  "title": "게스트로 설정 탭 맨 아래 「이용약관」·「개인정보처리방침」 링크를 누르면 각각 약관 창이 열린다 (설정 시동 연결 bindTermsLinks · bindPrivacyLinks 이전 전후 보존)",
  "steps": [
    { "do": "setViewport", "width": 430, "height": 932 },
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect", "timeoutMs": 10000 },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": "#btnAvatarGreetClose", "timeoutMs": 10000 },
    { "do": "click", "selector": "#btnAvatarGreetClose" },
    { "expect": "notVisible", "selector": "#btnAvatarGreetClose" },
    { "do": "waitFor", "selector": ".navbtn[data-tab=\"settings\"]", "timeoutMs": 10000 },
    { "do": "click", "selector": ".navbtn[data-tab=\"settings\"]" },
    { "do": "waitFor", "selector": "#setTermsLink", "timeoutMs": 15000 },
    { "expect": "notVisible", "selector": "#legalBody" },
    { "do": "click", "selector": "#setTermsLink" },
    { "expect": "textContains", "selector": "#legalBody", "text": "아워골 서비스 이용약관" },
    { "do": "click", "selector": "#legalCloseBtn" },
    { "expect": "notVisible", "selector": "#legalBody" },
    { "do": "click", "selector": "#setPrivacyLink" },
    { "expect": "textContains", "selector": "#legalBody", "text": "아워골 개인정보처리방침" },
    { "expect": "noExceptions" }
  ]
}
