{
  "id": "manito-ai-no-seed-gauge",
  "title": "게스트가 마니또를 시작하면 AI 동반자 카드에 시드로 만든 달성률 게이지가 나오지 않는다(AI 배지는 있다)",
  "steps": [
    {
      "do": "setViewport",
      "width": 375,
      "height": 812
    },
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "expect": "visible",
      "selector": ".navbtn[data-tab=\"comm\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"comm\"]"
    },
    {
      "do": "waitFor",
      "selector": ".comm-subtab[data-sub=\"manito\"]"
    },
    {
      "do": "click",
      "selector": ".comm-subtab[data-sub=\"manito\"]"
    },
    {
      "do": "waitFor",
      "selector": "#mnJoin"
    },
    {
      "do": "click",
      "selector": "#mnJoin"
    },
    {
      "expect": "visible",
      "selector": ".manito-card .badge-ai",
      "timeoutMs": 8000
    },
    {
      "expect": "notVisible",
      "selector": ".manito-card .gauge",
      "timeoutMs": 3000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
