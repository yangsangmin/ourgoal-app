{
  "id": "feed-honest-stage-label",
  "title": "공유된 실천이 없는 게스트가 소통 피드를 열면 실제로 없는 AI 가이드를 세는 라벨 대신 아직 공유된 실천이 없다는 라벨이 나온다",
  "steps": [
    {
      "do": "setViewport",
      "width": 375,
      "height": 812
    },
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "expect": "visible",
      "selector": ".navbtn[data-tab=\"comm\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"comm\"]"
    },
    {
      "do": "waitFor",
      "selector": ".comm-subtab[data-sub=\"feed\"]"
    },
    {
      "do": "click",
      "selector": ".comm-subtab[data-sub=\"feed\"]"
    },
    {
      "expect": "textContains",
      "selector": "#commSubBody",
      "text": "아직 공유된 실천이 없어요",
      "timeoutMs": 8000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
