{
  "id": "p105-goal-agent-drawer",
  "title": "게스트로 목표 탭에서 템플릿 목표를 하나 담은 뒤 「AI 목표 어시스턴트」 제목 줄을 누르면 서랍이 열려 입력칸이 보이고, 다시 누르면 닫히며 예외가 없다 (인라인 IIFE 마지막 정리 전후 보존 — 시동 문을 부팅 파일로 옮기고 상수 선언 두 줄만 index.html 에 남긴 뒤에도 같다)",
  "steps": [
    {
      "do": "setViewport",
      "width": 430,
      "height": 932
    },
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": "#btnAvatarGreetClose",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnAvatarGreetClose"
    },
    {
      "expect": "notVisible",
      "selector": "#btnAvatarGreetClose"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"goals\"]",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"goals\"]"
    },
    {
      "do": "waitFor",
      "selector": "#sanctuaryGoalsView .template-quick-card:first-child .btn-quick-adopt-goal",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": "#sanctuaryGoalsView .template-quick-card:first-child .btn-quick-adopt-goal"
    },
    {
      "do": "waitFor",
      "selector": "#btnToggleGoalAgent",
      "timeoutMs": 15000
    },
    {
      "expect": "notVisible",
      "selector": "#goalAgentInput"
    },
    {
      "do": "click",
      "selector": "#btnToggleGoalAgent"
    },
    {
      "expect": "visible",
      "selector": "#goalAgentInput"
    },
    {
      "do": "click",
      "selector": "#btnToggleGoalAgent"
    },
    {
      "expect": "notVisible",
      "selector": "#goalAgentInput"
    },
    {
      "expect": "noExceptions"
    }
  ]
}
