{
  "id": "p107-auth-forgot-password",
  "title": "시작 화면에서 로그인 화면으로 가 「비밀번호를 잊으셨나요?」를 누르면 「비밀번호 찾기」 창이 열린다 (인라인 IIFE 마지막 정리 전후 보존 — 시동 문을 부팅 파일로 옮기고 상수 선언 두 줄만 index.html 에 남긴 뒤에도 같다)",
  "steps": [
    {
      "do": "setViewport",
      "width": 430,
      "height": 932
    },
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#landLoginLink",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#landLoginLink"
    },
    {
      "do": "waitFor",
      "selector": "#forgotPassBtn",
      "timeoutMs": 10000
    },
    {
      "expect": "notVisible",
      "selector": "#modalSheet"
    },
    {
      "do": "click",
      "selector": "#forgotPassBtn"
    },
    {
      "expect": "textContains",
      "selector": "#modalSheet",
      "text": "비밀번호 찾기"
    },
    {
      "expect": "noExceptions"
    }
  ]
}
