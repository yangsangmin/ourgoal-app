{
  "id": "core-confetti",
  "title": "게스트로 홈 체크인 입력칸에 글을 쓰고 「기록」을 누르면 축하 꽃가루 조각이 화면에 뿌려진다 — 축하 꽃가루(burstConfetti)를 기관 세포 js/core/confetti.js 로 옮겼다(동작 그대로)",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": "#captureInput",
      "timeoutMs": 15000
    },
    {
      "do": "type",
      "selector": "#captureInput",
      "text": "아침 30분 걷기 완료"
    },
    {
      "do": "click",
      "selector": "#captureSave"
    },
    {
      "expect": "count",
      "selector": "#confettiLayer .confetti-piece",
      "min": 1,
      "timeoutMs": 3000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
