    { "do": "waitFor", "selector": ".navbtn[data-tab=\"comm\"]" },
    { "do": "click", "selector": ".navbtn[data-tab=\"comm\"]" },
    { "do": "waitFor", "selector": "#commBody" },
    { "expect": "visible", "selector": "#commBody" },
    { "capture": "comm-subtabs-rendered" }
  ]
}
