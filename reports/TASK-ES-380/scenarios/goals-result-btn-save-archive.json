{
  "id": "goals-result-btn-save-archive",
  "title": "게스트가 새 목표를 만들고 목표 탭에서 「+ 최종 결과」 버튼(375px 화면)을 눌러 결과를 저장하면 버튼이 「📝 결과 수정」으로 바뀌고 최종 결과 요약이 보이며, 다시 열어 「보관」을 누르면 「목표가 보관함으로 이동되었습니다」 토스트가 뜨고 목표 탭이 빈 목표 안내로 바뀌고, 그동안 미처리 예외가 0건이다",
  "viewport": { "width": 375, "height": 812 },
  "steps": [
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": "#homeAddGoal", "timeoutMs": 15000 },
    { "do": "click", "selector": "#homeAddGoal" },
    { "do": "waitFor", "selector": "#ngManualBtn" },
    { "do": "click", "selector": "#ngManualBtn" },
    { "do": "waitFor", "selector": "#mGoalTitle" },
    { "do": "type", "selector": "#mGoalTitle", "text": "최종 결과 버튼 확인 목표" },
    { "do": "click", "selector": "#mSave" },
    { "do": "wait", "ms": 1200 },
    { "do": "click", "selector": ".navbtn[data-tab=\"goals\"]" },
    { "expect": "textContains", "selector": "#goalDetailBody", "text": "전체 (3)" },
    { "expect": "visible", "selector": "#goalResultBtn" },
    { "expect": "textContains", "selector": "#goalResultBtn", "text": "+ 최종 결과" },
    { "expect": "rect", "selector": "#goalResultBtn", "minWidth": 40, "minHeight": 20 },
    { "expect": "noHorizontalOverflow" },
    { "capture": "goals-result-btn-375" },
    { "do": "click", "selector": "#goalResultBtn" },
    { "expect": "visible", "selector": "#rsSave" },
    { "do": "type", "selector": "#rsAiQuickInput", "text": "목표 끝까지 완주함" },
    { "do": "click", "selector": "#rsSave" },
    { "expect": "notVisible", "selector": "#rsSave" },
    { "expect": "textContains", "selector": "#goalResultBtn", "text": "결과 수정" },
    { "expect": "textContains", "selector": "#goalResultSummary", "text": "최종 결과" },
    { "capture": "goals-result-saved" },
    { "do": "click", "selector": "#goalResultBtn" },
    { "expect": "visible", "selector": "#rsJustArchive" },
    { "do": "click", "selector": "#rsJustArchive" },
    { "expect": "textContains", "selector": "#toast", "text": "목표가 보관함으로 이동되었습니다" },
    { "expect": "notVisible", "selector": "#rsJustArchive" },
    { "expect": "textContains", "selector": "#goalsHeadlineSentence", "text": "새로운 목표를 세우고" },
    { "capture": "goals-after-goal-archive" },
    { "expect": "noExceptions" }
  ]
}
