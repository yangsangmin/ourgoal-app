{
  "id": "c1-bell-modal-settings",
  "title": "게스트로 홈의 종 버튼으로 알림 센터 창을 두 번 열었다 닫고(통로 openModal·closeModal), 설정 탭에 들어갔다가(진입 때 collapseAllSettingsSections) 홈으로 돌아오면 누른 탭이 활성이 되며 예외가 없다 (시험에서 풀린 이름 배선 철거 전후 보존)",
  "steps": [
    {
      "do": "setViewport",
      "width": 430,
      "height": 932
    },
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": "#btnAvatarGreetClose",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnAvatarGreetClose"
    },
    {
      "expect": "notVisible",
      "selector": "#btnAvatarGreetClose"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"goals\"]",
      "timeoutMs": 10000
    },
    {
      "expect": "notExists",
      "selector": "#closeNotifCenterBtn"
    },
    {
      "do": "click",
      "selector": "#sanctuaryBellBtn"
    },
    {
      "do": "waitFor",
      "selector": "#closeNotifCenterBtn",
      "timeoutMs": 5000
    },
    {
      "expect": "visible",
      "selector": "#closeNotifCenterBtn"
    },
    {
      "do": "click",
      "selector": "#closeNotifCenterBtn"
    },
    {
      "expect": "notVisible",
      "selector": "#closeNotifCenterBtn"
    },
    {
      "do": "click",
      "selector": "#sanctuaryBellBtn"
    },
    {
      "do": "waitFor",
      "selector": "#closeNotifCenterBtn",
      "timeoutMs": 5000
    },
    {
      "expect": "visible",
      "selector": "#closeNotifCenterBtn"
    },
    {
      "do": "click",
      "selector": "#closeNotifCenterBtn"
    },
    {
      "expect": "notVisible",
      "selector": "#closeNotifCenterBtn"
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"settings\"]"
    },
    {
      "expect": "hasClass",
      "selector": ".navbtn[data-tab=\"settings\"]",
      "className": "active"
    },
    {
      "expect": "notHasClass",
      "selector": ".navbtn[data-tab=\"home\"]",
      "className": "active"
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"home\"]"
    },
    {
      "expect": "hasClass",
      "selector": ".navbtn[data-tab=\"home\"]",
      "className": "active"
    },
    {
      "expect": "notHasClass",
      "selector": ".navbtn[data-tab=\"settings\"]",
      "className": "active"
    },
    {
      "expect": "noExceptions"
    }
  ]
}
