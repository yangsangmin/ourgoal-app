{
  "id": "goals-team-goal-add",
  "title": "게스트로 팀을 만든 뒤 목표 탭 「👥 팀목표」 칸의 「+ 공동 팀 목표 추가」를 누르면 「팀 목표 추가」 창이 뜬다 — 새 팀 목표 만들기 창(promptNewTeamGoal)을 목표 탭 세포 파일로 옮겼다(동작 그대로)",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"home\"]",
      "timeoutMs": 15000
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"comm\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"comm\"]"
    },
    {
      "do": "waitFor",
      "selector": "#commBody [data-sub=\"group\"]",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#commBody [data-sub=\"group\"]"
    },
    {
      "do": "waitFor",
      "selector": "#btnHeroCreateTeamComm",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnHeroCreateTeamComm"
    },
    {
      "do": "waitFor",
      "selector": "#tplMarathonSmall",
      "timeoutMs": 8000
    },
    {
      "do": "click",
      "selector": "#tplMarathonSmall"
    },
    {
      "do": "click",
      "selector": "#gTopicMajor [data-major]:nth-child(1)"
    },
    {
      "do": "click",
      "selector": "#gTopicSub [data-sub]:nth-child(1)"
    },
    {
      "do": "click",
      "selector": "#grpSave"
    },
    {
      "do": "wait",
      "ms": 1500
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"goals\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"goals\"]"
    },
    {
      "do": "waitFor",
      "selector": "#btnGoalsSubTeam",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnGoalsSubTeam"
    },
    {
      "do": "waitFor",
      "selector": "[data-addteamgoal]",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "[data-addteamgoal]"
    },
    {
      "expect": "textContains",
      "selector": "#modalOverlay",
      "text": "팀 목표 추가",
      "timeoutMs": 8000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
