{
  "id": "comm-manito-preview",
  "title": "게스트로 소통 탭 「🎁 마니또」에 들어가면 익명 이름 미리보기(#mnPreviewName)가 그려진다 — 마니또 익명 이름·상태(genAnonName·hashStr·manitoState·manitoMajors·MANITO_*)를 소통 탭 세포 파일로 옮겼다(동작 그대로)",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"home\"]",
      "timeoutMs": 15000
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"comm\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"comm\"]"
    },
    {
      "do": "waitFor",
      "selector": "#commBody [data-sub=\"manito\"]",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#commBody [data-sub=\"manito\"]"
    },
    {
      "expect": "visible",
      "selector": "#mnPreviewName",
      "timeoutMs": 8000
    },
    {
      "expect": "visible",
      "selector": "#mnJoin",
      "timeoutMs": 4000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
