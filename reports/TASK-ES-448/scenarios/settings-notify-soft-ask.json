{
  "id": "settings-notify-soft-ask",
  "title": "게스트로 설정 탭 알림 묶음을 펼치고 체크인 알림 스위치(#notifySwitch)를 켜면 브라우저 권한 창보다 먼저 「스트릭을 안전하게 지켜드릴까요?」 앱 창이 뜬다 — 알림 허용 먼저 묻기 창(openNotificationSoftAskModal)을 설정 탭 세포 파일로 옮겼다(동작 그대로)",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"home\"]",
      "timeoutMs": 15000
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"settings\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"settings\"]"
    },
    {
      "do": "waitFor",
      "selector": "details:has(#notifySwitch) > summary",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "details:has(#notifySwitch) > summary"
    },
    {
      "do": "waitFor",
      "selector": "#notifySwitch",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#notifySwitch"
    },
    {
      "expect": "textContains",
      "selector": "#modalOverlay",
      "text": "스트릭을 안전하게 지켜드릴까요?",
      "timeoutMs": 8000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
