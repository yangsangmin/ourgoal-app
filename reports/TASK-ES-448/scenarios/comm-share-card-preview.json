{
  "id": "comm-share-card-preview",
  "title": "게스트로 홈 「오늘 목표」에서 갓생 스타터 「운동」 목표를 만들고 소통 탭 「📤 공유」에서 1:1 소통 카드 미리보기(#sharePreviewBtn)를 누르면 「1:1 소통 카드를 제작했어요」 토스트가 뜬다 — 공유 카드 캔버스 그리기(generateShareImage·drawShareWatermark·scWrapLines 등)를 소통 탭 세포 파일로 옮겼다(동작 그대로)",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"home\"]",
      "timeoutMs": 15000
    },
    {
      "do": "waitFor",
      "selector": "#homeCompassQuest",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#homeCompassQuest"
    },
    {
      "do": "waitFor",
      "selector": "[data-starter=\"workout\"]",
      "timeoutMs": 8000
    },
    {
      "do": "click",
      "selector": "[data-starter=\"workout\"]"
    },
    {
      "do": "wait",
      "ms": 1500
    },
    {
      "do": "click",
      "selector": "#homeDetailClose"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"comm\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"comm\"]"
    },
    {
      "do": "waitFor",
      "selector": "#commBody [data-sub=\"share\"]",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#commBody [data-sub=\"share\"]"
    },
    {
      "do": "waitFor",
      "selector": "#sharePreviewBtn",
      "timeoutMs": 8000
    },
    {
      "do": "click",
      "selector": "#sharePreviewBtn"
    },
    {
      "expect": "textContains",
      "selector": "#toast",
      "text": "1:1 소통 카드를 제작했어요",
      "timeoutMs": 15000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
