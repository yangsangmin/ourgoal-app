{
 "id": "records-theme-export-csv",
 "title": "게스트로 기록 탭 「빠른 기록」으로 기록을 하나 저장한 뒤 「내보내기」 창에서 「다운로드」를 누르면 「기록 1개를 다운로드했어요」 토스트가 뜬다 — 옮긴 buildCSV·getAIAnalysisPrompt(js/tabs/records/theme-export-csv.js)로 CSV 글자를 만든다",
 "steps": [
  {
   "do": "setViewport",
   "width": 430,
   "height": 3200
  },
  {
   "do": "goto",
   "path": "/index.html"
  },
  {
   "do": "waitFor",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "click",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "waitFor",
   "selector": ".navbtn[data-tab=\"records\"]",
   "timeoutMs": 15000
  },
  {
   "do": "click",
   "selector": ".navbtn[data-tab=\"records\"]"
  },
  {
   "do": "waitFor",
   "selector": "#recQuickDockBar",
   "timeoutMs": 15000
  },
  {
   "do": "click",
   "selector": "#recQuickDockBar > button:nth-child(3)"
  },
  {
   "do": "waitFor",
   "selector": "#recAgentInput",
   "timeoutMs": 8000
  },
  {
   "do": "type",
   "selector": "#recAgentInput",
   "text": "저녁에 헬스장에서 가슴운동 1시간"
  },
  {
   "do": "click",
   "selector": "#recAgentSendBtn"
  },
  {
   "do": "waitFor",
   "selector": "#recAiSaveBtn",
   "timeoutMs": 8000
  },
  {
   "do": "click",
   "selector": "#recAiSaveBtn"
  },
  {
   "do": "waitFor",
   "selector": ".screen.active .rec-card",
   "timeoutMs": 10000
  },
  {
   "do": "click",
   "selector": "#exportRecordsBtn"
  },
  {
   "do": "waitFor",
   "selector": "#mExpDownload",
   "timeoutMs": 5000
  },
  {
   "do": "click",
   "selector": "#mExpDownload"
  },
  {
   "expect": "textContains",
   "selector": "#toast",
   "text": "기록 1개를 다운로드했어요",
   "timeoutMs": 5000
  },
  {
   "expect": "noExceptions"
  }
 ]
}
