{
 "id": "records-pro-voice-sim",
 "title": "게스트로 전문 템플릿 기록 창의 「음성 입력」 창에서(마이크 권한 안내 창은 닫고) 예시 문장 칩 「벤치프레스 80kg 10회 3세트 45분」을 누르면 「[연속 추가] \"벤치프레스\" 행이 표에 추가되었습니다!」 토스트가 뜬다 — 옮긴 openVoiceTableModal·parseVoiceToTableRow(js/tabs/records/voice-table-input.js)가 이전 전과 같이 동작한다",
 "steps": [
  {
   "do": "setViewport",
   "width": 430,
   "height": 3200
  },
  {
   "do": "goto",
   "path": "/index.html"
  },
  {
   "do": "waitFor",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "click",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "waitFor",
   "selector": ".navbtn[data-tab=\"records\"]",
   "timeoutMs": 15000
  },
  {
   "do": "click",
   "selector": ".navbtn[data-tab=\"records\"]"
  },
  {
   "do": "waitFor",
   "selector": "#recQuickDockBar",
   "timeoutMs": 15000
  },
  {
   "do": "click",
   "selector": "#recQuickDockBar > button:nth-child(4)"
  },
  {
   "do": "waitFor",
   "selector": "#recOpenProTemplateBtn",
   "timeoutMs": 8000
  },
  {
   "do": "click",
   "selector": "#recOpenProTemplateBtn"
  },
  {
   "do": "waitFor",
   "selector": "#proCsvImportBtn",
   "timeoutMs": 10000
  },
  {
   "do": "click",
   "selector": "#proVoiceInputBtn"
  },
  {
   "do": "waitFor",
   "selector": "#voiceToggleBtn",
   "timeoutMs": 5000
  },
  {
   "do": "waitFor",
   "selector": "#btnCloseMicGuide",
   "timeoutMs": 5000
  },
  {
   "do": "click",
   "selector": "#btnCloseMicGuide"
  },
  {
   "do": "wait",
   "ms": 400
  },
  {
   "do": "click",
   "selector": "[data-voicesim=\"벤치프레스 80kg 10회 3세트 45분\"]"
  },
  {
   "expect": "textContains",
   "selector": "#toast",
   "text": "[연속 추가] \"벤치프레스\" 행이 표에 추가되었습니다!",
   "timeoutMs": 5000
  },
  {
   "expect": "textContains",
   "selector": "#voiceTranscriptBox",
   "text": "벤치프레스 80kg 10회 3세트 45분"
  },
  {
   "expect": "noExceptions"
  }
 ]
}
