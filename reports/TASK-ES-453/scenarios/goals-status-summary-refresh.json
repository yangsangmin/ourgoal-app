{
  "id": "goals-status-summary-refresh",
  "title": "게스트로 목표 탭 빈 화면에서 「10km 마라톤 완주 로드맵」 템플릿을 담고 「현재 종합상황」 막대를 펼치면, 목표 상세를 그릴 때 옮긴 종합상황 새로 고침(refreshGoalStatusSummary → 서버가 없으면 로컬 요약)이 채운 요약 글(1단계 마일스톤에 집중하고 있다는 문장)이 보인다",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"goals\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"goals\"]"
    },
    {
      "do": "waitFor",
      "selector": "#sanctuaryGoalsView .template-quick-card:first-child .btn-quick-adopt-goal",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": "#sanctuaryGoalsView .template-quick-card:first-child .btn-quick-adopt-goal"
    },
    {
      "do": "waitFor",
      "selector": "#goalStatusToggleBtn",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#goalStatusToggleBtn"
    },
    {
      "expect": "textContains",
      "selector": "#goalStatusText",
      "text": "마일스톤에 집중하고 있으며",
      "timeoutMs": 10000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
