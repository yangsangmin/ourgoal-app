{
  "id": "goals-agent-send",
  "title": "게스트로 목표 탭에서 템플릿 목표를 담은 뒤 「AI 목표 어시스턴트」를 펼쳐 요청 문장을 입력하고 「보내기」를 누르면 옮긴 대화 전송(sendGoalAgentMessage → requestGoalAgentDiff)이 불려, 서버 AI 가 없는 환경에서 이전 전과 같이 「요청을 처리하지 못했어요」 토스트를 띄운다",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"goals\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"goals\"]"
    },
    {
      "do": "waitFor",
      "selector": "#sanctuaryGoalsView .template-quick-card:first-child .btn-quick-adopt-goal",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": "#sanctuaryGoalsView .template-quick-card:first-child .btn-quick-adopt-goal"
    },
    {
      "expect": "textContains",
      "selector": "#toast",
      "text": "템플릿이 내 목표에"
    },
    {
      "do": "waitFor",
      "selector": "#btnToggleGoalAgent",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": "#btnToggleGoalAgent"
    },
    {
      "do": "waitFor",
      "selector": "#goalAgentInput",
      "timeoutMs": 5000
    },
    {
      "do": "type",
      "selector": "#goalAgentInput",
      "text": "마감일을 일주일 미뤄줘"
    },
    {
      "do": "click",
      "selector": "#goalAgentSendBtn"
    },
    {
      "expect": "textContains",
      "selector": "#toast",
      "text": "요청을 처리하지 못했어요",
      "timeoutMs": 10000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
