{
  "id": "p07-auth-forgot-password",
  "title": "시작 화면에서 로그인 화면으로 가 「비밀번호를 잊으셨나요?」를 누르면 「비밀번호 찾기」 창이 열린다 (등록 2차 전후 보존 — 이 조작이 부르는 연결 함수들을 세포가 등록 기관에 등록한 뒤에도 같다)",
  "steps": [
    {
      "do": "setViewport",
      "width": 430,
      "height": 932
    },
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#landLoginLink",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#landLoginLink"
    },
    {
      "do": "waitFor",
      "selector": "#forgotPassBtn",
      "timeoutMs": 10000
    },
    {
      "expect": "notVisible",
      "selector": "#modalSheet"
    },
    {
      "do": "click",
      "selector": "#forgotPassBtn"
    },
    {
      "expect": "textContains",
      "selector": "#modalSheet",
      "text": "비밀번호 찾기"
    },
    {
      "expect": "noExceptions"
    }
  ]
}
