{
  "id": "r07-auth-forgot-password",
  "title": "시작 화면에서 로그인 화면으로 가 「비밀번호를 잊으셨나요?」를 누르면 「비밀번호 찾기」 창이 열린다 (구역 이전 전후 보존 — 그 단추에 누름을 거는 문(fpBtn)과 계정 보안 부품 연결 connectAuthSafety 가 구역으로 갔다)",
  "steps": [
    {
      "do": "setViewport",
      "width": 430,
      "height": 932
    },
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#landLoginLink",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#landLoginLink"
    },
    {
      "do": "waitFor",
      "selector": "#forgotPassBtn",
      "timeoutMs": 10000
    },
    {
      "expect": "notVisible",
      "selector": "#modalSheet"
    },
    {
      "do": "click",
      "selector": "#forgotPassBtn"
    },
    {
      "expect": "textContains",
      "selector": "#modalSheet",
      "text": "비밀번호 찾기"
    },
    {
      "expect": "noExceptions"
    }
  ]
}
