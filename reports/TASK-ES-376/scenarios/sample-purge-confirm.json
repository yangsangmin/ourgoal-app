{
  "id": "sample-purge-confirm",
  "title": "게스트가 기록 탭에서 체험용 샘플을 불러온 뒤 「1초 정리하기」를 누르면 기본 확인창 대신 같은 문구의 앱 바텀시트 확인창이 뜨고, 취소하거나 뒤로가기로 닫으면 샘플이 그대로 남고(정리 배너 유지) · 확인하면 샘플이 정리되어 배너가 사라진다",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": "#homeAddGoal",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"records\"]"
    },
    {
      "do": "click",
      "selector": "#recQuickDockBar button[onclick*=\"recUniversalTopBanner\"]"
    },
    {
      "do": "click",
      "selector": "#recImportBannerBtn"
    },
    {
      "do": "click",
      "selector": "#modalSheet [data-quick-sample=\"hyrox\"]"
    },
    {
      "expect": "notVisible",
      "selector": "#modalOverlay"
    },
    {
      "expect": "visible",
      "selector": "#recSamplePurgeBtn"
    },
    {
      "do": "click",
      "selector": "#recSamplePurgeBtn"
    },
    {
      "expect": "visible",
      "selector": "#modalOverlay.active #btnSheetConfirmCancel"
    },
    {
      "expect": "textContains",
      "selector": "#modalSheet .sheet-confirm-body p",
      "text": "건만 말끔히 삭제할까요?"
    },
    {
      "capture": "sample-purge-confirm-sheet"
    },
    {
      "do": "click",
      "selector": "#btnSheetConfirmCancel"
    },
    {
      "expect": "notVisible",
      "selector": "#modalOverlay"
    },
    {
      "expect": "visible",
      "selector": "#recSamplePurgeBtn"
    },
    {
      "do": "click",
      "selector": "#recSamplePurgeBtn"
    },
    {
      "expect": "visible",
      "selector": "#modalOverlay.active #btnSheetConfirmOk"
    },
    {
      "do": "back"
    },
    {
      "expect": "notVisible",
      "selector": "#modalOverlay"
    },
    {
      "expect": "visible",
      "selector": "#recSamplePurgeBtn"
    },
    {
      "expect": "stillInApp"
    },
    {
      "do": "click",
      "selector": "#recSamplePurgeBtn"
    },
    {
      "expect": "visible",
      "selector": "#modalOverlay.active #btnSheetConfirmOk"
    },
    {
      "do": "click",
      "selector": "#btnSheetConfirmOk"
    },
    {
      "expect": "notVisible",
      "selector": "#modalOverlay"
    },
    {
      "expect": "notVisible",
      "selector": "#recSamplePurgeBtn"
    },
    {
      "expect": "textContains",
      "selector": "#toast",
      "text": "체험용 샘플 데이터가 모두 정리되었습니다"
    },
    {
      "expect": "noExceptions"
    }
  ]
}
