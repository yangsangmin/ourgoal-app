{
  "id": "f2s01-open-close",
  "title": "게스트로 기록 탭의 템플릿 카드에서 전문 템플릿 기록 창을 열면 헬스 표(4행)가 뜨고 「취소」로 닫히며, 빠른 칩 「공부」로 열면 공부 표(2행)로 뜬다 (창 틀 — 열기·닫기·처음 고른 템플릿) (인라인 IIFE 마지막 정리 전후 보존 — 시동 문을 부팅 파일로 옮기고 서버 연결 블록만 인라인에 남긴 뒤에도 같다)",
  "steps": [
    {
      "do": "setViewport",
      "width": 430,
      "height": 932
    },
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": "#btnAvatarGreetClose",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnAvatarGreetClose"
    },
    {
      "expect": "notVisible",
      "selector": "#btnAvatarGreetClose"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"records\"]",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"records\"]"
    },
    {
      "do": "waitFor",
      "selector": "#recQuickDockBar > button:nth-child(4)",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": "#recQuickDockBar > button:nth-child(4)"
    },
    {
      "do": "waitFor",
      "selector": "#recOpenProTemplateBtn",
      "timeoutMs": 10000
    },
    {
      "expect": "notVisible",
      "selector": "#proTable"
    },
    {
      "do": "click",
      "selector": "#recOpenProTemplateBtn"
    },
    {
      "expect": "visible",
      "selector": "#proTable"
    },
    {
      "expect": "textContains",
      "selector": "#modalSheet h3",
      "text": "전문(맞춤) 템플릿 기록"
    },
    {
      "expect": "textContains",
      "selector": ".pro-tpl-badge",
      "text": "헬스"
    },
    {
      "expect": "count",
      "selector": "#proTableBody tr",
      "equals": 4
    },
    {
      "do": "click",
      "selector": "#proCancelBtn"
    },
    {
      "expect": "notVisible",
      "selector": "#proTable"
    },
    {
      "do": "click",
      "selector": "#recQuickTemplateChips [data-quicktpl=\"study\"]"
    },
    {
      "expect": "visible",
      "selector": "#proTable"
    },
    {
      "expect": "textContains",
      "selector": ".pro-tpl-badge",
      "text": "공부"
    },
    {
      "expect": "count",
      "selector": "#proTableBody tr",
      "equals": 2
    },
    {
      "expect": "attr",
      "selector": ".pro-tpl-cell-input[data-row=\"0\"][data-col=\"1\"]",
      "name": "value",
      "equals": "영어 토익"
    },
    {
      "do": "click",
      "selector": "#proCancelBtn"
    },
    {
      "expect": "notVisible",
      "selector": "#proTable"
    },
    {
      "expect": "noExceptions"
    }
  ]
}
