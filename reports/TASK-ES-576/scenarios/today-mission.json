{
  "id": "today-mission-actual-ui",
  "title": "게스트로 추천 목표와 빠른 목표를 추가한 뒤 홈 퀘스트 나침반에서 오늘 미션 카드가 렌더링되고 아코디언 더보기가 펼쳐지고 접힌다",
  "steps": [
    { "do": "setViewport", "width": 430, "height": 3200 },
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": ".navbtn[data-tab=\"goals\"]", "timeoutMs": 15000 },
    { "do": "click", "selector": ".navbtn[data-tab=\"goals\"]" },
    { "do": "waitFor", "selector": ".btn-quick-adopt-goal[onclick*=\"10km\"]", "timeoutMs": 10000 },
    { "do": "click", "selector": ".btn-quick-adopt-goal[onclick*=\"10km\"]" },
    { "expect": "textContains", "selector": "#toast", "text": "10km 마라톤 완주 로드맵" },
    { "do": "click", "selector": ".navbtn[data-tab=\"goals\"]" },
    { "do": "waitFor", "selector": "#goalFastAddInput", "timeoutMs": 10000 },
    { "do": "type", "selector": "#goalFastAddInput", "text": "오늘 미션 두번째 목표" },
    { "do": "click", "selector": "#btnGoalFastAddSubmit" },
    { "expect": "count", "selector": "[data-sgoalid]", "equals": 2 },
    { "do": "click", "selector": ".navbtn[data-tab=\"home\"]" },
    { "do": "waitFor", "selector": "#homeCompassQuest", "timeoutMs": 10000 },
    { "do": "click", "selector": "#homeCompassQuest" },
    { "do": "waitFor", "selector": "#homeDetailSheet", "timeoutMs": 10000 },
    { "expect": "visible", "selector": "#homeDetailSheet" },
    { "expect": "visible", "selector": "#todayMissionCard" },
    { "expect": "textContains", "selector": "#todayMissionCard", "text": "오늘의 카드" },
    { "do": "waitFor", "selector": "#btnToggleMissionAccordion", "timeoutMs": 10000 },
    { "expect": "textContains", "selector": "#btnToggleMissionAccordion", "text": "외 1개 미션 더보기 ▾" },
    { "do": "click", "selector": "#btnToggleMissionAccordion" },
    { "do": "wait", "ms": 500 },
    { "expect": "textContains", "selector": "#btnToggleMissionAccordion", "text": "접기 ▴" },
    { "expect": "visible", "selector": "#missionRestList" },
    { "do": "click", "selector": "#btnToggleMissionAccordion" },
    { "do": "wait", "ms": 500 },
    { "expect": "textContains", "selector": "#btnToggleMissionAccordion", "text": "외 1개 미션 더보기 ▾" },
    { "expect": "notVisible", "selector": "#missionRestList" },
    { "do": "click", "selector": "#homeDetailClose" },
    { "do": "wait", "ms": 500 },
    { "expect": "notVisible", "selector": "#homeDetailSheet" },
    { "expect": "noExceptions" }
  ]
}
