{
 "id": "settings-tester-entry-auth-screen",
 "title": "배포 주소(로컬 개발 주소 아님)에서 첫 화면의 「로그인」을 누르면 로그인 화면이 열리고 테스터 B 직통 입장 단추는 없으며 예외가 없다 — 로드 중 원래 자리에서 부르는 bindLandTesterBButton·bindAuthTesterBButton(js/tabs/settings/tester-entry.js)이 이전 전과 같이 오류 없이 돈다",
 "steps": [
  { "do": "setViewport", "width": 430, "height": 3200 },
  { "do": "goto", "path": "/index.html" },
  { "do": "waitFor", "selector": "#landLoginLink" },
  { "expect": "notVisible", "selector": "#authScreen" },
  { "do": "click", "selector": "#landLoginLink" },
  { "do": "waitFor", "selector": "#loginSubmit", "timeoutMs": 10000 },
  { "expect": "visible", "selector": "#authScreen" },
  { "expect": "notExists", "selector": "#authTesterBBtn" },
  { "expect": "notExists", "selector": "#landTesterBBtn" },
  { "expect": "noExceptions" }
 ]
}
