{
  "id": "u5-comm-team-create-local",
  "title": "게스트로 소통 탭 「👥 팀」에서 「+ 새 팀 개설하기」를 누르고 추천 「🔥 목표 완주 크루」와 카테고리를 골라 「팀 만들기」를 누르면 새 팀이 팀 목록에 그려진다 (모임 목록 배열에 끼워 넣은 것이 화면에 닿는 길 — 상태 기관으로 옮기기 전후 보존. 게스트는 서버 연결이 없어 이 브라우저 안에서만 만들어진다)",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"home\"]",
      "timeoutMs": 15000
    },
    {
      "do": "waitFor",
      "selector": ".navbtn[data-tab=\"comm\"]",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"comm\"]"
    },
    {
      "do": "waitFor",
      "selector": "#commBody [data-sub=\"group\"]",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#commBody [data-sub=\"group\"]"
    },
    {
      "do": "waitFor",
      "selector": "#btnHeroCreateTeamComm",
      "timeoutMs": 10000
    },
    {
      "do": "click",
      "selector": "#btnHeroCreateTeamComm"
    },
    {
      "do": "waitFor",
      "selector": "#tplMarathonSmall",
      "timeoutMs": 8000
    },
    {
      "do": "click",
      "selector": "#tplMarathonSmall"
    },
    {
      "do": "click",
      "selector": "#gTopicMajor [data-major]:nth-child(1)"
    },
    {
      "expect": "visible",
      "selector": "#gTopicSub [data-sub]:nth-child(1)",
      "timeoutMs": 6000
    },
    {
      "do": "click",
      "selector": "#gTopicSub [data-sub]:nth-child(1)"
    },
    {
      "do": "click",
      "selector": "#grpSave"
    },
    {
      "expect": "textContains",
      "selector": "#screen-comm",
      "text": "목표 완주 크루",
      "timeoutMs": 10000
    },
    {
      "expect": "noExceptions"
    }
  ]
}
