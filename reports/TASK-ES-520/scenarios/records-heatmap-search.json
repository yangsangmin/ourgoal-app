{
 "id": "records-heatmap-search",
 "title": "게스트로 기록 탭 「빠른 기록」으로 기록을 하나 저장한 뒤 검색칸에 없는 낱말을 치면 「해당 테마 또는 검색 조건에 맞는 기록이 없어요」가 뜨고, 「히트맵·통계」의 오늘 칸이 가장 진한 색(rgb(31, 201, 142))으로 칠해진다 — 옮긴 filterRecordsByQuery·heatmapLevel·HEATMAP_LEVELS(js/tabs/records/record-heatmap-levels.js)가 이전 전과 같이 동작한다",
 "steps": [
  {
   "do": "setViewport",
   "width": 430,
   "height": 3200
  },
  {
   "do": "goto",
   "path": "/index.html"
  },
  {
   "do": "waitFor",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "click",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "waitFor",
   "selector": ".navbtn[data-tab=\"records\"]",
   "timeoutMs": 15000
  },
  {
   "do": "click",
   "selector": ".navbtn[data-tab=\"records\"]"
  },
  {
   "do": "waitFor",
   "selector": "#recQuickDockBar",
   "timeoutMs": 15000
  },
  {
   "do": "click",
   "selector": "#recQuickDockBar > button:nth-child(3)"
  },
  {
   "do": "waitFor",
   "selector": "#recAgentInput",
   "timeoutMs": 8000
  },
  {
   "do": "type",
   "selector": "#recAgentInput",
   "text": "저녁에 헬스장에서 가슴운동 1시간"
  },
  {
   "do": "click",
   "selector": "#recAgentSendBtn"
  },
  {
   "do": "waitFor",
   "selector": "#recAiSaveBtn",
   "timeoutMs": 8000
  },
  {
   "do": "click",
   "selector": "#recAiSaveBtn"
  },
  {
   "do": "waitFor",
   "selector": ".screen.active .rec-card",
   "timeoutMs": 10000
  },
  {
   "do": "click",
   "selector": "#recSearchInput"
  },
  {
   "do": "type",
   "selector": "#recSearchInput",
   "text": "없는검색어zz"
  },
  {
   "expect": "textContains",
   "selector": "#recordsList",
   "text": "해당 테마 또는 검색 조건에 맞는 기록이 없어요",
   "timeoutMs": 5000
  },
  {
   "do": "click",
   "selector": "button.s-rec-mode-btn[onclick*=\"heatmap\"]"
  },
  {
   "do": "waitFor",
   "selector": "#recordHeatmap .heatmap-cell.active",
   "timeoutMs": 8000
  },
  {
   "expect": "style",
   "selector": "#recordHeatmap .heatmap-cell.active",
   "prop": "background-color",
   "equals": "rgb(31, 201, 142)"
  },
  {
   "expect": "attr",
   "selector": "#recordHeatmap .heatmap-cell.active",
   "name": "data-count",
   "equals": "1"
  },
  {
   "expect": "noExceptions"
  }
 ]
}
