{
  "id": "shipyard-all-tabs",
  "title": "게스트 진입 후 6대 핵심 탭을 순회하면 모든 메가블록 및 도크 화면이 정상 렌더링된다",
  "steps": [
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": "#screen-home" },
    { "expect": "visible", "selector": "#screen-home" },
    { "do": "click", "selector": ".navbtn[data-tab=\"goals\"]" },
    { "do": "waitFor", "selector": "#screen-goals" },
    { "expect": "visible", "selector": "#screen-goals" },
    { "do": "click", "selector": ".navbtn[data-tab=\"calendar\"]" },
    { "do": "waitFor", "selector": "#screen-calendar" },
    { "expect": "visible", "selector": "#screen-calendar" },
    { "do": "click", "selector": ".navbtn[data-tab=\"records\"]" },
    { "do": "waitFor", "selector": "#screen-records" },
    { "expect": "visible", "selector": "#screen-records" },
    { "do": "click", "selector": ".navbtn[data-tab=\"comm\"]" },
    { "do": "waitFor", "selector": "#screen-comm" },
    { "expect": "visible", "selector": "#screen-comm" },
    { "do": "click", "selector": ".navbtn[data-tab=\"settings\"]" },
    { "do": "waitFor", "selector": "#screen-settings" },
    { "expect": "visible", "selector": "#screen-settings" },
    { "capture": "shipyard-all-tabs-complete" }
  ]
}
