{
  "id": "home-sheet-today-card",
  "title": "게스트가 홈 「🎯 오늘 목표」 시트에서 시작 목표(👟 주 3회 헬스)를 하나 만들면 같은 시트 위쪽에 「오늘의 카드」(#todayMissionCard 미션 카드)가 보인다 — 고치기 전에는 4테마 공통 숨김(#todayMissionCard, display:none !important)이 시트로 옮긴 카드까지 숨겼다",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "expect": "visible",
      "selector": "#homeAddGoal",
      "timeoutMs": 15000
    },
    {
      "expect": "notVisible",
      "selector": "#avatarGreetingModal",
      "timeoutMs": 8000
    },
    {
      "do": "click",
      "selector": "#homeCompassQuest"
    },
    {
      "expect": "hasClass",
      "selector": "#homeDetailSheet",
      "className": "open"
    },
    {
      "do": "click",
      "selector": ".starter-goal-btn[data-starter=\"workout\"]"
    },
    {
      "expect": "notVisible",
      "selector": ".starter-goal-btn[data-starter=\"workout\"]",
      "timeoutMs": 8000
    },
    {
      "expect": "hasClass",
      "selector": "#homeDetailSheet",
      "className": "open"
    },
    {
      "expect": "visible",
      "selector": "#todayMissionCard .mission-card",
      "timeoutMs": 6000
    },
    {
      "expect": "textContains",
      "selector": "#todayMissionCard",
      "text": "오늘의 카드"
    },
    {
      "expect": "noExceptions"
    }
  ]
}
