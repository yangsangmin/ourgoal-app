{
 "id": "auth-login-tab-forgot-password",
 "title": "게스트로 첫 화면 「로그인」을 눌러 로그인 화면에서 「로그인」 탭을 누르면 로그인 양식이 보이고, 「비밀번호를 잊으셨나요?」를 누르면 비밀번호 재설정 창이 열린다 — 옮긴 bindAuthTabButtons·openForgotPasswordModal(js/tabs/settings/auth-screen-actions.js)",
 "steps": [
  {
   "do": "setViewport",
   "width": 430,
   "height": 3200
  },
  {
   "do": "goto",
   "path": "/index.html"
  },
  {
   "do": "waitFor",
   "selector": "#landLoginLink"
  },
  {
   "do": "click",
   "selector": "#landLoginLink"
  },
  {
   "do": "waitFor",
   "selector": "#authScreen .auth-tab[data-authtab=\"login\"]"
  },
  {
   "do": "click",
   "selector": "#authScreen .auth-tab[data-authtab=\"login\"]"
  },
  {
   "expect": "visible",
   "selector": "#loginForm"
  },
  {
   "expect": "hasClass",
   "selector": "#authScreen .auth-tab[data-authtab=\"login\"]",
   "className": "active"
  },
  {
   "do": "click",
   "selector": "#forgotPassBtn"
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "expect": "visible",
   "selector": "#resetEmailInput"
  },
  {
   "expect": "noExceptions"
  }
 ]
}
