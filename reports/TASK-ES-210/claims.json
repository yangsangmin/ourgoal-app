{
  "task": "TASK-ES-210",
  "requirementsSource": "docs/specs/REQ-TASK-ES-210-ALL-TABS-TOSS-INNOVATION.md",
  "requirements": [
    {
      "id": "R1",
      "text": "전 6대 탭에 토스식 문장형 헤드라인 스타일(.toss-headline)이 정의되고 적용되어야 한다"
    },
    {
      "id": "R2",
      "text": "목표 탭에 마운틴 트레일과 마일스톤이 일체화된 단일 퀘스트 보드(.toss-quest-board) 구조가 정의되어야 한다"
    },
    {
      "id": "R3",
      "text": "모바일 인터랙션 강화를 위한 미세 햅틱 피드백(triggerHapticFeedback) 함수가 정의되고 마일스톤/체크인에 배선되어야 한다"
    },
    {
      "id": "R4",
      "text": "설정 탭에 토스 스타일의 둥근 그룹핑 카드(.toss-settings-group) 스타일이 선언되고 배선되어야 한다"
    },
    {
      "id": "R5",
      "text": "목표 탭 상단에 상태를 요약하는 문장형 헤드라인 요소(#goalsHeadlineSentence)가 배선되어야 한다"
    }
  ],
  "claims": [
    {
      "id": "C1",
      "req": "R1",
      "kind": "static",
      "domain": "config",
      "statement": "ui.css에 .toss-headline 클래스가 정의되어 문장형 헤드라인 스타일을 제공한다",
      "touches": [
        "ui.css"
      ],
      "check": {
        "type": "codeContains",
        "file": "ui.css",
        "text": ".toss-headline"
      }
    },
    {
      "id": "C2",
      "req": "R2",
      "kind": "static",
      "domain": "config",
      "statement": "ui.css에 .toss-quest-board 클래스가 정의되어 단일 퀘스트 보드 레이아웃을 제공한다",
      "touches": [
        "ui.css"
      ],
      "check": {
        "type": "codeContains",
        "file": "ui.css",
        "text": ".toss-quest-board"
      }
    },
    {
      "id": "C3",
      "req": "R3",
      "kind": "static",
      "domain": "config",
      "statement": "index.html에 function triggerHapticFeedback 함수가 정의되어 햅틱 피드백을 제공한다",
      "touches": [
        "index.html"
      ],
      "check": {
        "type": "codeContains",
        "file": "index.html",
        "text": "function triggerHapticFeedback"
      }
    },
    {
      "id": "C4",
      "req": "R4",
      "kind": "static",
      "domain": "config",
      "statement": "ui.css에 .toss-settings-group 클래스가 정의되어 설정 탭 둥근 카드 그루핑을 제공한다",
      "touches": [
        "ui.css"
      ],
      "check": {
        "type": "codeContains",
        "file": "ui.css",
        "text": ".toss-settings-group"
      }
    },
    {
      "id": "C5",
      "req": "R5",
      "kind": "static",
      "domain": "config",
      "statement": "index.html에 id=\"goalsHeadlineSentence\" 요소가 정의되어 문장형 헤드라인을 렌더링한다",
      "touches": [
        "index.html"
      ],
      "check": {
        "type": "codeContains",
        "file": "index.html",
        "text": "id=\"goalsHeadlineSentence\""
      }
    }
  ]
}
