{
 "id": "date-rollover-guest-tabs",
 "title": "게스트로 앱에 들어가 기록·캘린더 탭을 거쳐 홈으로 돌아오면(전체 다시 그리기가 옮긴 setupDateRolloverWatcher 로 자정 워처를 건다) 각 화면이 보이고 홈으로 돌아와도 예외가 없다 — js/core/date-rollover.js",
 "steps": [
  {
   "do": "setViewport",
   "width": 430,
   "height": 3200
  },
  {
   "do": "goto",
   "path": "/index.html"
  },
  {
   "do": "waitFor",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "click",
   "selector": "#btnLandingPreviewDirect"
  },
  {
   "do": "waitFor",
   "selector": ".navbtn[data-tab=\"settings\"]",
   "timeoutMs": 15000
  },
  {
   "do": "click",
   "selector": ".navbtn[data-tab=\"records\"]"
  },
  {
   "expect": "visible",
   "selector": "#screen-records"
  },
  {
   "do": "click",
   "selector": ".navbtn[data-tab=\"calendar\"]"
  },
  {
   "expect": "visible",
   "selector": "#screen-calendar"
  },
  {
   "do": "click",
   "selector": ".navbtn[data-tab=\"home\"]"
  },
  {
   "expect": "visible",
   "selector": "#screen-home"
  },
  {
   "expect": "noExceptions"
  }
 ]
}
