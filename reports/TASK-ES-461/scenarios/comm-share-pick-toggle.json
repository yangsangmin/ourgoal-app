{
  "id": "comm-share-pick-toggle",
  "title": "게스트로 홈 갓생 스타터 「운동」 목표를 만들고 소통 탭 「📤 공유」에서 「목표 & 달성률」 줄을 누르면 체크가 꺼진다 — 공유 하위 화면 그리기와 그 줄 처리기(renderCommShare)를 소통 탭 세포 파일 js/tabs/comm/goal-certificate-share.js 로 옮겼다(동작 그대로)",
  "steps": [
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": ".navbtn[data-tab=\"home\"]", "timeoutMs": 15000 },
    { "do": "waitFor", "selector": "#homeCompassQuest", "timeoutMs": 10000 },
    { "do": "click", "selector": "#homeCompassQuest" },
    { "do": "waitFor", "selector": "[data-starter=\"workout\"]", "timeoutMs": 8000 },
    { "do": "click", "selector": "[data-starter=\"workout\"]" },
    { "do": "wait", "ms": 1500 },
    { "do": "click", "selector": "#homeDetailClose" },
    { "do": "waitFor", "selector": ".navbtn[data-tab=\"comm\"]", "timeoutMs": 15000 },
    { "do": "click", "selector": ".navbtn[data-tab=\"comm\"]" },
    { "do": "waitFor", "selector": "#commBody [data-sub=\"share\"]", "timeoutMs": 10000 },
    { "do": "click", "selector": "#commBody [data-sub=\"share\"]" },
    { "do": "waitFor", "selector": "#commSubBody [data-scpick=\"goal\"]", "timeoutMs": 8000 },
    { "expect": "hasClass", "selector": "#commSubBody [data-scchk=\"goal\"]", "className": "on" },
    { "do": "click", "selector": "#commSubBody [data-scpick=\"goal\"]" },
    { "expect": "notHasClass", "selector": "#commSubBody [data-scchk=\"goal\"]", "className": "on", "timeoutMs": 6000 },
    { "expect": "noExceptions" }
  ]
}
