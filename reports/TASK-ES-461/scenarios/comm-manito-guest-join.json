{
  "id": "comm-manito-guest-join",
  "title": "게스트로 소통 탭 「🎁 마니또」에서 「마니또 시작하기」를 누르면 「게스트 모드로 AI 마니또 3명이 배정됐어요」 토스트가 뜨고 마니또 화면이 참여 상태(「그만두기」 단추)로 다시 그려진다 — 마니또 화면 그리기와 참여 처리(renderCommManito·isValidRealUser)를 소통 탭 세포 파일 js/tabs/comm/manito-real.js 로 옮겼다(동작 그대로)",
  "steps": [
    { "do": "goto", "path": "/index.html" },
    { "do": "waitFor", "selector": "#btnLandingPreviewDirect" },
    { "do": "click", "selector": "#btnLandingPreviewDirect" },
    { "do": "waitFor", "selector": ".navbtn[data-tab=\"comm\"]", "timeoutMs": 15000 },
    { "do": "click", "selector": ".navbtn[data-tab=\"comm\"]" },
    { "do": "waitFor", "selector": "#commBody [data-sub=\"manito\"]", "timeoutMs": 10000 },
    { "do": "click", "selector": "#commBody [data-sub=\"manito\"]" },
    { "do": "waitFor", "selector": "#mnJoin", "timeoutMs": 8000 },
    { "expect": "notExists", "selector": "#mnQuit" },
    { "do": "click", "selector": "#mnJoin" },
    { "expect": "textContains", "selector": "#toast", "text": "게스트 모드로 AI 마니또 3명이 배정됐어요", "timeoutMs": 8000 },
    { "expect": "visible", "selector": "#mnQuit", "timeoutMs": 6000 },
    { "expect": "noExceptions" }
  ]
}
