{
  "id": "team-level-accordion-feedback",
  "title": "게스트가 「팀 수준별 목표 관리」 머리를 누르면 화살표에 rotated(펼침 표시)가 붙고 본문이 보이며, 다시 누르면 화살표 rotated 가 빠지고 본문이 사라진다 — 기준 커밋에서는 클릭 직후(단계 11) 화살표에 rotated 가 없다",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": "#homeAddGoal",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"goals\"]"
    },
    {
      "do": "click",
      "selector": "#btnGoalsSubTeam"
    },
    {
      "do": "click",
      "selector": "[data-tgexampletab=\"fitness\"]"
    },
    {
      "do": "click",
      "selector": "#tgQuickJoinSampleBtn"
    },
    {
      "expect": "textContains",
      "selector": "#teamGoalsView [data-tglevelaccordion]",
      "text": "팀 수준별 목표 관리",
      "timeoutMs": 5000
    },
    {
      "do": "click",
      "selector": "#teamGoalsView [data-tglevelaccordion]"
    },
    {
      "expect": "hasClass",
      "selector": "#teamGoalsView [data-tglevelaccordion] .tg-accordion-arrow",
      "className": "rotated",
      "timeoutMs": 3000
    },
    {
      "expect": "visible",
      "selector": "#teamGoalsView [data-tglevelbody]"
    },
    {
      "do": "click",
      "selector": "#teamGoalsView [data-tglevelaccordion]"
    },
    {
      "expect": "notHasClass",
      "selector": "#teamGoalsView [data-tglevelaccordion] .tg-accordion-arrow",
      "className": "rotated",
      "timeoutMs": 3000
    },
    {
      "expect": "notVisible",
      "selector": "#teamGoalsView [data-tglevelbody]"
    },
    {
      "expect": "noExceptions"
    }
  ]
}