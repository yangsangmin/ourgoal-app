{
  "id": "team-level-accordion-rerender",
  "title": "게스트가 「팀 수준별 목표 관리」 머리를 눌러 펼친 뒤 「팀 연계」 서브탭으로 갔다가 「팀목표」로 돌아와도(팀 목표 화면 다시 그림 + 일괄 접기) 본문 「팀 통합 수준관리」 글자가 계속 보인다 — 기준 커밋에서는 클릭 직후(단계 11) 본문이 보이지 않는다",
  "steps": [
    {
      "do": "goto",
      "path": "/index.html"
    },
    {
      "do": "waitFor",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "click",
      "selector": "#btnLandingPreviewDirect"
    },
    {
      "do": "waitFor",
      "selector": "#homeAddGoal",
      "timeoutMs": 15000
    },
    {
      "do": "click",
      "selector": ".navbtn[data-tab=\"goals\"]"
    },
    {
      "do": "click",
      "selector": "#btnGoalsSubTeam"
    },
    {
      "do": "click",
      "selector": "[data-tgexampletab=\"fitness\"]"
    },
    {
      "do": "click",
      "selector": "#tgQuickJoinSampleBtn"
    },
    {
      "expect": "textContains",
      "selector": "#teamGoalsView [data-tglevelaccordion]",
      "text": "팀 수준별 목표 관리",
      "timeoutMs": 5000
    },
    {
      "do": "click",
      "selector": "#teamGoalsView [data-tglevelaccordion]"
    },
    {
      "expect": "textContains",
      "selector": "#teamGoalsView [data-tglevelbody]",
      "text": "팀 통합 수준관리",
      "timeoutMs": 3000
    },
    {
      "do": "click",
      "selector": "#btnGoalsSubTeamLinked"
    },
    {
      "do": "click",
      "selector": "#btnGoalsSubTeam"
    },
    {
      "expect": "textContains",
      "selector": "#teamGoalsView [data-tglevelbody]",
      "text": "목표별 수준관리",
      "timeoutMs": 3000
    },
    {
      "capture": "level-open-after-rerender"
    },
    {
      "expect": "noExceptions"
    }
  ]
}